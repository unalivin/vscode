<?xml version="1.0" encoding="utf-8"?>
<!-- Legacy launcher icon for API 21-25, which have no adaptive-icon support.
     The foreground vector already carries its own background square, so the
     layer list only has to place it. API 26+ resolves the anydpi-v26 variant. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ic_launcher_background" />
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
